# ERPNext / backend API
# Base URL of the ERPNext (Frappe) REST API, used by the /app dashboard once
# a session exists. Points at a local bench in dev, the real instance in
# production.
VITE_API_BASE_URL=http://localhost:8000/api

# Registration and login are native pages served directly by the ERPNext
# backend (same-origin with its own API — see tijarat_app/www/register.html
# and login.html), not by this SPA. This is that backend's public URL.
VITE_PORTAL_URL=https://portal.tijaratapp.com

# Web3Forms (https://web3forms.com) — free, no backend required.
# Get a key by entering an email at web3forms.com (use nabeel.munawar@gmail.com
# so submissions land there) — takes under a minute, no account/password needed.
# Contact, Request a demo, and the newsletter signup all use this key.
VITE_WEB3FORMS_ACCESS_KEY=
